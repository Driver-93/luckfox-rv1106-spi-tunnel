#!/bin/sh
# /etc/init.d/S24spinet_wd -- spinet.py 看门狗
#
# ⚠️ 说明: 这个文件以前是给**内核模块版** (spitun.ko) 写的, 判据是
#    "ping 10.77.0.1 通不通"。现在隧道改用**用户态 spinet.py**
#    (它操作 /dev/spidev0.0 + /dev/net/tun), 判据换回"进程在不在"
#    —— 因为 spinet.py 自己内部就有完整的重传/ACK/超时逻辑, 进程活着
#    就说明隧道在工作; 进程死了才会真的断网。
#
# 为什么需要看门狗:
#    spinet.py 启动时要等 C5 握手, 最长 120 秒。如果 C5 还没上电/SPI 没就绪,
#    它会自己退出并返回 1。没有看门狗的话板子就永久断网了。
#
# ⚠️ 绝对不阻塞 rcS: start 只派发一个后台守护, 立刻返回。
#    (用两次刷机换来的教训: rcS 串行执行, 任何阻塞脚本都会让后面的
#     S40network/S50sshd/S99* 全不执行, 表现是 ping 通但 SSH 全死。)

SCRIPT=/userdata/car/spinet.py
LOGF=/userdata/spinet.log
PIDF=/var/run/spinet_wd.pid
INTERVAL=20

log() { echo "[S24spinet_wd] $1"; }

running() {
    # 匹配 spinet.py (Python 版) 和 spinet (C 版) 两种二进制
    ps | grep '[s]pinet' | grep -vE 'S22spinet|S24spinet|grep' >/dev/null 2>&1
}

wd_loop() {
    while true; do
        if ! running; then
            log "$(date '+%H:%M:%S') spinet 未运行, 重新拉起"
            cd /userdata/car 2>/dev/null || cd /
            if [ -x /userdata/car/spinet_c ]; then
                nohup /userdata/car/spinet_c >> "$LOGF" 2>&1 &
            else
                nohup python3 -u "$SCRIPT" >> "$LOGF" 2>&1 &
            fi
            log "  pid=$!"
        fi
        sleep $INTERVAL
    done
}

start() {
    if [ -f "$PIDF" ] && kill -0 "$(cat $PIDF 2>/dev/null)" 2>/dev/null; then
        log "看门狗已在运行 (pid $(cat $PIDF))"
        return 0
    fi
    log "启动看门狗 (间隔 ${INTERVAL}s)"
    setsid sh -c "$0 wdloop" </dev/null >/dev/null 2>&1 &
    log "已派发"
}

case "$1" in
    start)   start ;;
    stop)
        log "停看门狗"
        [ -f "$PIDF" ] && kill "$(cat $PIDF)" 2>/dev/null
        rm -f "$PIDF"
        ;;
    wdloop)
        echo $$ > "$PIDF"
        wd_loop
        ;;
    status)
        running && echo "spinet:   running" || echo "spinet:   NOT running"
        if [ -f "$PIDF" ]; then echo "watchdog: pid $(cat $PIDF)"; else echo "watchdog: not started"; fi
        ;;
    *) echo "usage: $0 {start|stop|status}"; exit 1 ;;
esac
