#!/bin/sh
# /etc/init.d/S22pwm -- 应用 4 路硬件 PWM overlay (电机调速)
#
# 为什么需要它:
#   电机的 4 路调速走**硬件 PWM** (pwmchip10/8/6/11)。而 /sys/class/pwm/ 下
#   的 pwmchipN 只有在 pwm4 overlay 应用后才出现。没有这个脚本,
#   /sys/class/pwm/ 是空的, 电机就无法调速。
#
# ⚠️ overlay 只能在重启边界安全切换 (热换会泄漏 IOMUX, 文档里有血泪记录)。
#    本脚本在开机时运行, 属于正确的时机。
#
# ⚠️ 绝不阻塞 rcS: rcS 串行执行 S* 脚本, 卡住会导致后面全不执行,
#    表现为"ping 通但 SSH/Web 全死", 只能刷机。

DTS=/userdata/hwcfg/pwm4.dts
DTBO=/userdata/hwcfg/pwm4.dtbo
OVL=/sys/kernel/config/device-tree/overlays/pwm4

log() { echo "[S22pwm] $1"; }

ensure_configfs() {
    [ -d /sys/kernel/config/device-tree ] && return 0
    grep -q configfs /proc/mounts || {
        mkdir -p /sys/kernel/config
        mount -t configfs none /sys/kernel/config 2>/dev/null
    }
    i=0
    while [ $i -lt 30 ]; do
        [ -d /sys/kernel/config/device-tree ] && return 0
        sleep 0.1; i=$((i+1))
    done
    return 1
}

do_overlay() {
    if [ ! -f "$DTBO" ] && [ -f "$DTS" ]; then
        log "compiling $DTS"
        dtc -@ -I dts -O dtb -o "$DTBO" "$DTS" 2>/dev/null
    fi
    [ -f "$DTBO" ] || { log "ERROR: $DTBO missing"; return 1; }

    [ -d "$OVL" ] && { echo 0 > $OVL/status 2>/dev/null; rmdir $OVL 2>/dev/null; }
    mkdir -p $OVL
    cat "$DTBO" > $OVL/dtbo
    echo 1 > $OVL/status
    log "overlay applied, status=$(cat $OVL/status 2>/dev/null)"
}

start() {
    if ! ensure_configfs; then
        log "ERROR: configfs unavailable"
        return 1
    fi
    do_overlay

    # 报告结果 (不阻塞)
    n=0
    for d in /sys/class/pwm/pwmchip*; do
        [ -d "$d" ] && n=$((n+1))
    done
    log "pwmchips present: $n (expect 4)"
    for d in /sys/class/pwm/pwmchip*; do
        [ -d "$d" ] && log "  $(basename $d) npwm=$(cat $d/npwm 2>/dev/null)"
    done
}

status() {
    echo "overlay: $(ls /sys/kernel/config/device-tree/overlays/ 2>/dev/null | tr '\n' ' ')"
    echo "pwmchips:"
    for d in /sys/class/pwm/pwmchip*; do
        [ -d "$d" ] || continue
        echo "  $(basename $d) npwm=$(cat $d/npwm 2>/dev/null)"
    done
}

case "$1" in
    start)  start ;;
    stop)   log "stop does nothing (overlay stays)" ;;
    restart) start ;;
    status) status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
