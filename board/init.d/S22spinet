#!/bin/sh
# /etc/init.d/S22spinet -- onboard SPI gateway; the board's ONLY network path.
#
# WHY S22 AND NOT S99z:
#   Every init script runs in numeric order. As S99z this started at t~16s, so
#   the board was unreachable for the first ~30 seconds after a reboot.
#   Its dependencies are all ready much earlier -- /dev/spidev0.0 comes from
#   devtmpfs within the first second, and /dev/net/tun is created by S21tun
#   which runs immediately before this -- so there was nothing to wait for.

NAME=spinet
DIR=/userdata/car
SCRIPT=$DIR/spinet.py
LOG=/userdata/spinet.log
PIDF=/var/run/spinet.pid

is_running() {
    [ -f "$PIDF" ] || return 1
    P=$(cat "$PIDF" 2>/dev/null)
    [ -n "$P" ] || return 1
    kill -0 "$P" 2>/dev/null
}

launch() {
    cd "$DIR" || return 1
    # 2026-10-08: C 版泵 (spinet_c) 优先 -- 同一协议的 C 移植, 隧道转发
    # 从 ~25% CPU 降到 ~6%, 且帧率更高 (340 vs 290 fps)。spinet.py 保留
    # 作为回滚 (删掉/改名 spinet_c 即回到 Python 版)。
    if [ -x "$DIR/spinet_c" ]; then
        nohup "$DIR/spinet_c" >>"$LOG" 2>&1 </dev/null &
    else
        nohup python3 -u "$SCRIPT" >>"$LOG" 2>&1 </dev/null &
    fi
    P=$!
    [ -z "$P" ] && return 1
    echo "$P" > "$PIDF"
    return 0
}

start() {
    if is_running; then
        echo "$NAME already running (pid $(cat $PIDF))"
        return 0
    fi

    # Wait for /dev/spidev0.0. It only appears once the SPI controller has
    # probed, which happens after the device tree overlay is applied
    # (S21hwcfg). Waiting here is nearly free -- this runs at t~2s, long before
    # anything else is ready -- and it removes the old failure mode where the
    # script gave up after 5s and the watchdog only retried 10s later.
    i=0
    while [ ! -e /dev/spidev0.0 ] && [ $i -lt 25 ]; do
        [ $i -eq 5 ] && echo "  waiting for /dev/spidev0.0 ..."
        [ $i -eq 15 ] && echo "  still waiting for /dev/spidev0.0 ..."
        sleep 1
        i=$((i+1))
    done
    if [ ! -e /dev/spidev0.0 ]; then
        echo "$NAME: /dev/spidev0.0 not found after ${i}s, abort"
        return 1
    fi

    echo "Starting $NAME"
    if ! launch; then
        echo "$NAME: launch failed"
        return 1
    fi
    # One second, not four: spinet logs its own progress and S24spinet_wd
    # supervises it, so blocking boot to "verify" buys nothing.
    : # no blocking sleep: spinet logs its own progress and S63spinet_wd supervises it
    if ! is_running; then
        echo "$NAME: exited right after start, log tail:"
        tail -8 "$LOG" 2>/dev/null | sed 's/^/  /'
        rm -f "$PIDF"
        return 1
    fi
    echo "  pid=$(cat $PIDF) log=$LOG"
    return 0
}

stop() {
    echo "Stopping $NAME"
    if [ -f "$PIDF" ]; then
        P=$(cat "$PIDF")
        kill "$P" 2>/dev/null
        sleep 1
        kill -9 "$P" 2>/dev/null
        rm -f "$PIDF"
    fi
    for p in $(ps | grep 'spinet' | grep -vE 'grep|S22spinet|S24spinet' | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null
    done
    return 0
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)
        if is_running; then echo "$NAME running (pid $(cat $PIDF))"
        else echo "$NAME not running"; exit 1; fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
