#!/bin/sh
# /etc/init.d/S25rkipc -- 摄像头服务 (带硬件检测)
#
# ⚠️ 严格遵守"不阻塞 rcS": start 只派发后台任务, 立刻返回。
#
# ⚠️ 踩过的坑 (第一版 bug):
#   `( do_start ) >/dev/null 2>&1 &` 在 rcS 阶段**不可靠** ——
#   父 shell 退出时子 shell 的 insmod/rkipc 会被连带回收, 结果:
#   开机后 sc3336 模块没加载、rkipc 也没起来。
#   改用 setsid 彻底脱离会话 (和 S23web/S24spinet_wd 一致)。
#
# 行为:
#   1) 等网络就绪 (bind 需要接口地址)
#   2) 加载 sc3336.ko
#   3) 检测 sensor 是否应答
#   4) 启动 rkipc (带正确 LIBPATH, 含 NPU 模型目录)
#
# ⚠️ 2026-10-08 重要变更: RkLunch.sh 里的 rkipc 启动已被禁用
#    (/oem/usr/bin/RkLunch.sh, 备份在 /userdata/RkLunch.sh.bak)。
#    现在 **本脚本是 rkipc 的唯一启动者**。
#
#    为什么必须这样:
#      RkLunch 用原厂环境起 rkipc (LD_LIBRARY_PATH 缺 /usr/lib),
#      NPU 模型加载不了; 本脚本必须杀掉它重建, 于是 rkipc 开机被启两次。
#      dmesg 实证: venc 初始化 6 次 / 释放 2 次 / rkisp stream on 2 次。
#      两次 ISP 初始化让"开机到图传"耗时在 29~41s 之间**波动 12s**。
#      禁用 RkLunch 那份之后: 波动降到 1.8s。
#
#    因此原来的"20 秒竞态检测 / 让位 / 杀重建"逻辑**已全部删除** ——
#    没有竞争者了, 那些等待纯属浪费启动时间。

KO=/oem/usr/ko/sc3336.ko
RKIPC=/oem/usr/bin/rkipc
IQDIR=/oem/usr/share/iqfiles
LOG=/tmp/rkipc.log
# ⚠️ 必须含 /usr/lib: NPU 的模型 (object_detection_pfp*.data) 装在那里,
#    少了它 rkipc 的 rockiva 初始化会失败 (表现为网页没有检测框)。
LIBPATH=/oem/usr/lib:/usr/lib:/oem/lib
WORKER=/tmp/.s25rkipc_worker

log() { echo "[S25rkipc] $1"; }

# ⚠️ 不能用 `ps | grep '[r]kipc'` —— 当启动命令的字符串里含 "rkipc" 时
#    (例如 `sh -c "... /etc/init.d/S25rkipc status ..."`), 那个 shell 自身
#    也会被匹配到, 造成"rkipc 已在运行"的假象。
#    改用 ps 的 comm/args 精确匹配二进制路径。
running() {
    for p in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        c=$(cat /proc/$p/comm 2>/dev/null)
        [ "$c" = "rkipc" ] && return 0
    done
    return 1
}

rkpid() {
    for p in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        c=$(cat /proc/$p/comm 2>/dev/null)
        [ "$c" = "rkipc" ] && { echo "$p"; return; }
    done
}

# 写一个 worker 脚本, 由 setsid 拉起来 (彻底脱离 rcS 会话)
make_worker() {
    cat > "$WORKER" <<'EOF'
#!/bin/sh
KO=/oem/usr/ko/sc3336.ko
RKIPC=/oem/usr/bin/rkipc
IQDIR=/oem/usr/share/iqfiles
LOG=/tmp/rkipc.log
LIBPATH=/oem/usr/lib:/usr/lib:/oem/lib

# 0) 等网络就绪 —— 但**要快**
#
#    ⚠️ 症状: rkipc 日志里每次开机都有
#        RKSockServer {initNetServer:088} bind failed,
#        reason: Cannot assign requested address
#    原因: 本脚本是 S25, 而 **S40network 在网络就绪**。rkipc 起来时
#    eth0 还没有 IP, 它的 RKSockServer 想 bind 到接口地址就 EADDRNOTAVAIL,
#    导致 RTSP 要再等约 5 秒才真正可用。
#
#    实测: dmesg 里 `eth0: Link is Up` 出现在 ~6.1s, DHCP 地址随后即到。
#    所以这里只需要一个**短轮询**(最多 15s, 100ms 粒度), 不能像以前那样
#    1 秒粒度死等 40 秒 —— 那会把启动时间白白拖长, 而网络其实早好了。
i=0
while [ $i -lt 150 ]; do
    if ifconfig eth0 2>/dev/null | grep -q 'inet addr:'; then
        echo "[S25rkipc] network ready after $((i / 10)).$((i % 10))s"
        break
    fi
    i=$((i + 1))
    sleep 0.1
done
[ $i -ge 150 ] && echo "[S25rkipc] !! network not ready after 15s, starting anyway"

# 1) sensor 驱动
lsmod | grep -q '^sc3336' || { insmod "$KO" 2>/dev/null; sleep 2; }

# 2) 检查 sensor 应答
if dmesg | grep -q 'sc3336.*Unexpected sensor id'; then
    echo "[S25rkipc] !! SC3336 无应答 (I2C 无设备) -- 检查 CSI 排线与供电"
    exit 1
fi

# 3) 启动 rkipc
#    RkLunch.sh 里的那份已经禁用了, 所以这里**不需要**再等/让位/杀重建。
#    (旧逻辑见 git 历史: 曾用 20 秒轮询 + /usr/lib 环境检查, 因为当时
#     RkLunch 会抢先用错误环境起一个。现在没有竞争者, 直接启动即可。)
#
#    注意 exec 前必须 cd 到一个可写目录(日志/临时文件), 且带 LIBPATH。
cd /userdata 2>/dev/null || cd /
LD_LIBRARY_PATH="$LIBPATH" exec "$RKIPC" -a "$IQDIR" > "$LOG" 2>&1
EOF
    chmod 755 "$WORKER"
}

start() {
    if running; then
        log "rkipc 已在运行, 跳过"
        return 0
    fi
    make_worker
    log "派发后台 worker (setsid, 不阻塞启动)"
    setsid "$WORKER" </dev/null >/dev/null 2>&1 &
    return 0
}

case "$1" in
    start)   start ;;
    stop)
        log "停 rkipc"
        P=$(rkpid)
        [ -n "$P" ] && kill -9 "$P" 2>/dev/null
        log "已停"
        ;;
    restart)
        P=$(rkpid)
        [ -n "$P" ] && kill -9 "$P" 2>/dev/null
        sleep 1
        start
        ;;
    status)
        if running; then
            echo "rkipc: running (pid $(rkpid))"
        else
            echo "rkipc: NOT running"
        fi
        echo "sc3336 模块: $(lsmod | grep -c '^sc3336')"
        if dmesg | grep -q 'sc3336.*Unexpected sensor id'; then
            echo "sensor:  !! 无应答 (硬件问题)"
        else
            echo "sensor:  OK"
        fi
        netstat -ltn 2>/dev/null | grep -q ':554' && echo "RTSP :554 监听中" || echo "RTSP :554 未监听"
        ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
